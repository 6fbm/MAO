# Always LF in the repository, native line endings in the working tree.
* text=auto

# Scripts need the line endings of their platform.
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.ps1  text eol=crlf
*.sh   text eol=lf

# No diff noise for binaries.
*.png  binary
*.jpg  binary
*.gif  binary
*.cast binary
